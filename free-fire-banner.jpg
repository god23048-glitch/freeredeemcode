<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Free Fire Diamond Vault & Player Registry</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Gaming Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ffdark: '#0a0b10',
                        ffcard: '#16192b',
                        ffred: '#ff2a2a',
                        fforange: '#ff8800',
                        ffblue: '#00e5ff'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a0b10;
            color: #ffffff;
        }
        h1, h2, h3, .font-rajdhani {
            font-family: 'Rajdhani', sans-serif;
        }
        .glow-effect {
            box-shadow: 0 0 25px rgba(255, 42, 42, 0.3);
        }
        .glow-blue {
            box-shadow: 0 0 20px rgba(0, 229, 255, 0.2);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-ffdark">

    <!-- Header / Navbar -->
    <header class="bg-ffcard border-b border-red-900/40 sticky top-0 z-40 backdrop-blur-md bg-opacity-90">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-gradient-to-tr from-ffred to-fforange p-2 rounded-lg glow-effect">
                    <i class="fa-solid fa-gamepad text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-wider uppercase bg-gradient-to-r from-ffred via-fforange to-yellow-400 bg-clip-text text-transparent">FF Diamond Vault</h1>
                    <p class="text-xs text-gray-400">Official Player Registry & Rewards</p>
                </div>
            </div>
            <div class="hidden md:flex items-center space-x-2 bg-black/40 px-3 py-1.5 rounded-full border border-gray-800">
                <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
                <span class="text-xs text-gray-300 font-medium">Server Online</span>
            </div>
        </div>
    </header>

    <!-- Main Hero & Content -->
    <main class="flex-grow max-w-6xl mx-auto px-4 py-8 w-full">
        
        <!-- Hero Banner Section -->
        <div class="relative rounded-2xl overflow-hidden mb-10 border border-red-500/30 glow-effect bg-ffcard">
            <div class="absolute inset-0 bg-gradient-to-t from-ffdark via-ffdark/60 to-transparent z-10"></div>
            <!-- Banner Image (Make sure file is named free-fire-banner.jpg in your repository) -->
            <img src="free-fire-banner.jpg" alt="Free Fire Crimson Battle Force Banner" class="w-full h-64 md:h-80 object-cover object-center opacity-80 transform hover:scale-105 transition duration-700">
            <div class="absolute bottom-6 left-6 z-20 max-w-xl">
                <span class="bg-ffred/80 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest border border-red-400">Season 2026 Elite</span>
                <h2 class="text-3xl md:text-5xl font-extrabold uppercase font-rajdhani mt-2 text-white drop-shadow-md">Claim Your Free Diamonds</h2>
                <p class="text-gray-300 text-sm md:text-base mt-1">Register your profile credentials into the secure vault and generate your elite reward link instantly.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Registration Form Column -->
            <div class="lg:col-span-1 bg-ffcard p-6 rounded-2xl border border-red-900/40 shadow-xl self-start">
                <div class="flex items-center space-x-2 mb-6 border-b border-gray-800 pb-4">
                    <i class="fa-solid fa-id-card text-ffred text-xl"></i>
                    <h3 class="text-xl font-bold uppercase tracking-wide font-rajdhani">Player Registration</h3>
                </div>

                <form id="playerForm" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Free Fire User ID</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500"><i class="fa-solid fa-hashtag"></i></span>
                            <input type="number" id="userId" required placeholder="e.g. 482910293" class="w-full bg-black/50 border border-gray-800 rounded-lg pl-10 pr-4 py-2.5 text-white placeholder-gray-600 focus:outline-none focus:border-ffred transition">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Player Name (IGN)</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500"><i class="fa-solid fa-user"></i></span>
                            <input type="text" id="userName" required placeholder="e.g. ꧁ΔSSΔSSIN꧂" class="w-full bg-black/50 border border-gray-800 rounded-lg pl-10 pr-4 py-2.5 text-white placeholder-gray-600 focus:outline-none focus:border-ffred transition">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Age</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500"><i class="fa-solid fa-cake-candles"></i></span>
                            <input type="number" id="userAge" required min="10" max="99" placeholder="e.g. 19" class="w-full bg-black/50 border border-gray-800 rounded-lg pl-10 pr-4 py-2.5 text-white placeholder-gray-600 focus:outline-none focus:border-ffred transition">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Diamonds Required</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-fforange"><i class="fa-solid fa-gem"></i></span>
                            <select id="userDiamonds" class="w-full bg-black/50 border border-gray-800 rounded-lg pl-10 pr-4 py-2.5 text-white focus:outline-none focus:border-ffred transition">
                                <option value="1060 Diamonds" class="bg-ffcard">1,060 Diamonds (Elite Pack)</option>
                                <option value="2180 Diamonds" class="bg-ffcard">2,180 Diamonds (Pro Vault)</option>
                                <option value="5600 Diamonds" class="bg-ffcard">5,600 Diamonds (Legendary)</option>
                                <option value="10000 Diamonds" class="bg-ffcard">10,000 Diamonds (Max Level)</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="w-full mt-2 bg-gradient-to-r from-ffred to-fforange hover:from-red-600 hover:to-orange-600 text-white font-bold py-3 px-4 rounded-lg tracking-wider uppercase shadow-lg glow-effect transition transform active:scale-95 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-vault"></i>
                        <span>Save Player to Vault</span>
                    </button>
                </form>
            </div>

            <!-- Vault Entries Showcase Column -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-ffcard p-6 rounded-2xl border border-red-900/40 shadow-xl">
                    <div class="flex justify-between items-center mb-6 border-b border-gray-800 pb-4">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid fa-shield-halved text-ffblue text-xl"></i>
                            <h3 class="text-xl font-bold uppercase tracking-wide font-rajdhani">Registered Vault Records</h3>
                        </div>
                        <span id="recordCount" class="text-xs bg-black/60 border border-gray-800 text-gray-400 px-3 py-1 rounded-full">0 Records</span>
                    </div>

                    <!-- Cards Container -->
                    <div id="vaultContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Dynamic Player Cards injected via JS -->
                    </div>

                    <div id="emptyState" class="text-center py-12">
                        <i class="fa-solid fa-box-open text-gray-600 text-4xl mb-3"></i>
                        <p class="text-gray-400 text-sm">No player records found in the vault yet.</p>
                        <p class="text-xs text-gray-600 mt-1">Fill out the form on the left to register your credentials.</p>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Redeem Code Success Modal Popup -->
    <div id="redeemModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden">
        <div class="bg-ffcard border border-ffblue/40 rounded-2xl max-w-md w-full p-6 mx-4 glow-blue relative transform transition-all scale-95 opacity-0" id="modalContent">
            <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 glow-blue">
                    <i class="fa-solid fa-ticket text-white text-2xl"></i>
                </div>
                <h3 class="text-2xl font-bold uppercase font-rajdhani text-white">Redeem Code Generated!</h3>
                <p class="text-gray-300 text-sm mt-1">Your player profile has been successfully saved to the vault.</p>
                
                <div class="my-6 bg-black/60 border border-cyan-500/30 rounded-xl p-4">
                    <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Your Exclusive Telegram Channel Link:</p>
                    <a href="https://t.me/freeredeemcode2026" target="_blank" class="text-ffblue font-mono font-semibold text-sm hover:underline break-all block">
                        https://t.me/freeredeemcode2026
                    </a>
                </div>

                <div class="flex space-x-3">
                    <a href="https://t.me/freeredeemcode2026" target="_blank" class="flex-1 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white font-bold py-3 rounded-lg uppercase tracking-wider text-sm shadow-lg transition flex items-center justify-center space-x-2">
                        <i class="fa-brands fa-telegram text-lg"></i>
                        <span>Join Telegram Link</span>
                    </a>
                    <button id="closeModal" class="bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold py-3 px-4 rounded-lg text-sm transition">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-ffcard border-t border-gray-900 mt-12 py-6 text-center text-xs text-gray-500">
        <p>&copy; 2026 Free Fire Vault Registry. Not affiliated with Garena.</p>
    </footer>

    <!-- JavaScript Handling -->
    <script>
        const playerForm = document.getElementById('playerForm');
        const vaultContainer = document.getElementById('vaultContainer');
        const emptyState = document.getElementById('emptyState');
        const recordCount = document.getElementById('recordCount');
        const redeemModal = document.getElementById('redeemModal');
        const modalContent = document.getElementById('modalContent');
        const closeModal = document.getElementById('closeModal');

        // Load existing players from LocalStorage on startup
        let players = JSON.parse(localStorage.getItem('ff_vault_players')) || [];

        function renderVault() {
            vaultContainer.innerHTML = '';
            if (players.length === 0) {
                emptyState.classList.remove('hidden');
                recordCount.innerText = '0 Records';
                return;
            }

            emptyState.classList.add('hidden');
            recordCount.innerText = `${players.length} Record${players.length > 1 ? 's' : ''}`;

            players.forEach((player, index) => {
                const card = document.createElement('div');
                card.className = 'bg-black/40 border border-red-900/30 rounded-xl p-4 relative overflow-hidden group hover:border-ffred/50 transition';
                card.innerHTML = `
                    <div class="absolute top-0 right-0 bg-red-900/20 text-ffred text-[10px] font-bold px-2 py-0.5 rounded-bl-lg uppercase tracking-wider border-l border-b border-red-900/40">Verified</div>
                    <div class="flex items-center space-x-3 mb-3">
                        <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-ffred to-fforange flex items-center justify-center text-white font-bold">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-base text-white tracking-wide font-rajdhani">${escapeHtml(player.name)}</h4>
                            <p class="text-xs text-gray-400">ID: <span class="text-ffblue font-mono">${escapeHtml(player.userId)}</span> | Age: ${escapeHtml(player.age)}</p>
                        </div>
                    </div>
                    <div class="bg-black/60 rounded-lg p-2.5 flex items-center justify-between border border-gray-800">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid fa-gem text-fforange"></i>
                            <span class="text-xs text-gray-300 font-medium">Vault Allocation:</span>
                        </div>
                        <span class="text-xs font-bold text-yellow-400 font-rajdhani">${escapeHtml(player.diamonds)}</span>
                    </div>
                `;
                vaultContainer.appendChild(card);
            });
        }

        playerForm.addEventListener('submit', function(e) {
            e.preventDefault();

            const newPlayer = {
                userId: document.getElementById('userId').value,
                name: document.getElementById('userName').value,
                age: document.getElementById('userAge').value,
                diamonds: document.getElementById('userDiamonds').value
            };

            players.unshift(newPlayer); // Add to top of list
            localStorage.setItem('ff_vault_players', JSON.stringify(players));

            renderVault();
            playerForm.reset();

            // Show Redeem Code Modal
            redeemModal.classList.remove('hidden');
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        });

        function closeModalHandler() {
            modalContent.classList.remove('scale-100', 'opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                redeemModal.classList.add('hidden');
            }, 200);
        }

        closeModal.addEventListener('click', closeModalHandler);
        redeemModal.addEventListener('click', function(e) {
            if (e.target === redeemModal) closeModalHandler();
        });

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        // Initialize vault view on load
        renderVault();
    </script>
</body>
</html>
